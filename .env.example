# Copy to ignored .env. Fill only local PostgreSQL credentials and a fresh
# 32-byte random lowercase hex proxy secret; never add exchange API keys.
POSTGRES_USER=research
POSTGRES_DB=spot_research
POSTGRES_PASSWORD=
LOCAL_PROXY_SECRET=
LOCAL_WEB_HOST=127.0.0.1
LOCAL_WEB_PORT=5173
TRADING_PLATFORM_FRONTEND_ORIGIN=http://127.0.0.1:5173
TRADING_PLATFORM_ENVIRONMENT=dev
TRADING_PLATFORM_MODE=research
ENABLE_LIVE_TRADING=false
ENABLE_AUTO_EXECUTION=false
TRADING_PLATFORM_BINANCE_SPOT_ENABLED=false
TRADING_PLATFORM_BINANCE_SPOT_TERMS_REVIEW_REFERENCE=
TRADING_PLATFORM_BINANCE_SPOT_REGION_REVIEW_REFERENCE=
TRADING_PLATFORM_BINANCE_SPOT_INTEGRATION_REFERENCE=
