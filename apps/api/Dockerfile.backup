FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl gnupg \
    && install -d -m 0755 /usr/share/postgresql-common/pgdg \
    && curl --fail --silent --show-error --location \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor --output /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install --yes --no-install-recommends postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./
COPY apps/api/README.md apps/api/README.md
COPY apps/api/src apps/api/src
RUN pip install --no-cache-dir . \
    && useradd --system --uid 10001 research \
    && mkdir -p /run/backup-config /backup/archive /backup/bundles \
    && chown -R research:research /run/backup-config /backup

USER research
ENTRYPOINT ["python", "-m", "trading_platform_api.lineage.docker_backup_runner"]
